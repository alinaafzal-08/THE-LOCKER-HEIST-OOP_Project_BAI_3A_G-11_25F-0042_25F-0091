<?xml version="1.0" encoding="utf-8"?>
<!--
    TheLockerHeist.vcxproj.filters
    Organises the three source files into logical groups inside the
    Visual Studio Solution Explorer so the project is easy to navigate.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- Define two filters (folders) in Solution Explorer -->
  <ItemGroup>
    <Filter Include="Source Files">
      <UniqueIdentifier>{4FC737F1-C7A5-4376-A066-2A32D752A2FF}</UniqueIdentifier>
      <Extensions>cpp;c;cc;cxx</Extensions>
    </Filter>
    <Filter Include="Header Files">
      <UniqueIdentifier>{93995380-89BD-4b04-88EB-625FBE52EBFB}</UniqueIdentifier>
      <Extensions>h;hh;hpp;hxx</Extensions>
    </Filter>
  </ItemGroup>

  <!-- Assign each file to its filter -->
  <ItemGroup>
    <ClCompile Include="heist.cpp">
      <Filter>Source Files</Filter>
    </ClCompile>
    <ClCompile Include="main.cpp">
      <Filter>Source Files</Filter>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="heist.h">
      <Filter>Header Files</Filter>
    </ClInclude>
  </ItemGroup>

</Project>
